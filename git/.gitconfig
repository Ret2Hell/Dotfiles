[user]
  name = Ret2Hell
  email = tayeb1920@gmail.com

[includeIf "gitdir:/home/ret2hell/Work/github.com/raiselabs-mohamed/"]
  path = ~/.gitconfig-work

[core]
  pager = delta

[interactive]
  diffFilter = delta --color-only

[delta]
  dark = true
  hyperlinks = true
  line-numbers = true
  navigate = true
  relative-paths = true

[merge]
  conflictStyle = zdiff3
