{
  "if err return err": {
    "prefix": "ie",
    "body": [
      "if err != nil {",
      "\treturn err",
      "}"
    ],
    "description": "Return err when err is not nil"
  },
  "if err return nil err": {
    "prefix": "ien",
    "body": [
      "if err != nil {",
      "\treturn nil, err",
      "}"
    ],
    "description": "Return nil and err when err is not nil"
  },
  "if err return zero err": {
    "prefix": "iez",
    "body": [
      "if err != nil {",
      "\treturn ${1:nil}, err",
      "}"
    ],
    "description": "Return a custom zero value and err"
  },
  "if err wrapped": {
    "prefix": "ief",
    "body": [
      "if err != nil {",
      "\treturn fmt.Errorf(\"${1:failed to ${2:do thing}}: %w\", err)",
      "}"
    ],
    "description": "Return a wrapped error with fmt.Errorf"
  },
  "if err log fatal": {
    "prefix": "iel",
    "body": [
      "if err != nil {",
      "\tlog.Fatal(err)",
      "}"
    ],
    "description": "Log fatal when err is not nil"
